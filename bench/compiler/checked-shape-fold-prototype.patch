+// A bounded constructor spine has known shape even when its leaf values are
+// dynamic. Expose it to a matched consumer only when every dynamic leaf is a
+// variable; moving a call, let, or effect across the consumer would be unsafe.
+function known_ctr_spine(book: Bend.Book, term: HTerm,
+  fuel = 64): boolean {
+  if (fuel <= 0) return false;
+  const x = term_strip(term);
+  if (x.$ !== "Ctr") return false;
+  return ctr_flds(book, x.k, x.x).every((field) => {
+    const value = term_strip(field);
+    return term_const(value) || value.$ === "Var"
+      || known_ctr_spine(book, field, fuel - 1);
+  });
+}
